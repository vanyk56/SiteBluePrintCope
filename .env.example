# ============================================================
#  site-blueprint — настройки LLM (любой OpenAI-совместимый API)
#  Скопируй в .env и впиши ключ:  cp .env.example .env
# ============================================================

# --- По умолчанию: Z.ai, GLM-5.3-Flash (мультимодальная — получает скриншоты) ---
LLM_PROVIDER=zai
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# Если у тебя GLM Coding Plan — используй его endpoint:
# LLM_PROVIDER=zai-coding          # https://api.z.ai/api/coding/paas/v4

# --- Другие провайдеры: раскомментируй один блок (имена моделей — примеры, сверь с документацией провайдера) ---

# Google Gemini (OpenAI-совместимый endpoint)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-google-ai-studio-key
# LLM_MODEL=gemini-2.5-flash

# DeepSeek (текстовая модель — скриншоты не отправляются)
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# OpenRouter (сотни моделей по одному ключу)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# Ollama локально (без ключа)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5vl:7b

# Любой другой OpenAI-совместимый сервис (River AI, vLLM, LM Studio, прокси…) — пресета нет, работает через custom.
# Базовый URL и имя модели возьми из документации сервиса (нужен endpoint, совместимый с OpenAI /chat/completions).
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=...
# LLM_MODEL=...
# LLM_VISION=off                   # если модель не принимает картинки

# --- Тонкая настройка (необязательно) ---
# LLM_VISION=auto                 # on | off | auto — отправлять ли скриншоты в модель
# LLM_MAX_IMAGES=6                # скриншотов на страницу
# LLM_TEMPERATURE=1               # для GLM рекомендуется 1.0 (уже по умолчанию для zai)
# LLM_TOP_P=0.95
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_MS=600000
# LLM_CONCURRENCY=1               # параллельных запросов (у бесплатных тарифов лимит обычно 1–2)
# LLM_REASONING_EFFORT=           # low | medium | high — если модель поддерживает
# LLM_EXTRA_BODY={"key":"value"}  # дополнительные поля тела запроса (JSON), если провайдеру что-то нужно

# ============================================================
#  Краулер, плагины, расширение, самопроверка (необязательно)
# ============================================================
# BROWSER_PATH=                   # свой Chrome/Chromium/Edge вместо скачанного Playwright (= --browser-path)
# SB_PLUGINS=./examples/plugin-example.mjs   # плагины-хуки через запятую (= --plugin)
# SB_LISTEN_TOKEN=                # общий секрет для `site-blueprint listen`; тот же токен впиши в настройках расширения
# SB_NEXT_MODULES=                # готовый node_modules с next/react/tailwind (тесты, офлайн): на Linux/macOS подключается
#                                 # жёсткими ссылками вместо npm install; если не вышло (или Windows) — обычный npm install
